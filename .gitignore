# Written by setup.py on each PC: the skills, the scripts they share, and the rules, with this
# PC's paths filled in, and this PC's settings. Never commit either.
/internal/.generated/
/local-settings.json

# This PC's link to the Python the skills run, which setup.py makes.
/internal/.python/

# Throwaway copies that the tests build and run.
.test-sandbox/

# The development tools (see internal/development/pyproject.toml) and what they write.
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Windows thumbnail cache files
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Folder config file
[Dd]esktop.ini

# Windows shortcuts
*.lnk

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!*.code-workspace
